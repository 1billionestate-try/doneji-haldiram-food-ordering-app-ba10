# Copy this to .env.local and fill in your OWN values.
# .env.local is in .gitignore and must NEVER be committed.

DATABASE_URL=postgresql://user:password@host/dbname
SECRET_KEY=some-long-random-string
# DoneJi issues this one, per project. It is how the platform checks the live
# site is really yours, so treat it like any other secret: the real value goes
# in your host's environment settings, never in a commit.
DONEJI_VERIFY_TOKEN=

# UPI collection. Leave BLANK and the payment panel does not appear at all —
# the app works exactly as before, cash only. Fill it in and customers can pay
# you directly, into this UPI ID, with no gateway and no fees.
#
# It is YOUR UPI ID and YOUR responsibility: money goes straight to your bank,
# there is no refund button, and nobody can reverse a payment for you.
UPI_VPA=
UPI_PAYEE_NAME=
